# Copiá este archivo como ".env" (sin ".example") y completá los valores
# con los datos de tu proyecto de Firebase (Configuración del proyecto > Tus apps).
# Una variable por línea, sin comillas y sin comas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
